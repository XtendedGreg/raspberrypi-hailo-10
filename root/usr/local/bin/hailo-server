#!/bin/bash
# Hailo Server Launch Script

if [ ! -z $1 ]; then
    docker stop open-webui
    /usr/bin/screen -S hailo-server -X stuff "stop\n"
    exit 0
fi

docker run -d   --network=host   -e OLLAMA_BASE_URL=http://127.0.0.1:8000   -v open-webui:/app/backend/data   --name open-webui   --restart always   ghcr.io/open-webui/open-webui:main 2> /dev/null || docker start open-webui
export HAILO_MONITOR=1

if [ ! -e /var/log/hailo-server ]; then
    sudo mkdir -p /var/log/hailo-server
    sudo chmod -R 777 /var/log/hailo-server
fi

echo $(date) - Starting Hailo-Server | tee -a /var/log/hailo-server/hailo-server.log

hailo-ollama | tee -a /var/log/hailo-server/hailo-server.log
